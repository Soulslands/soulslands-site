// Cloudflare Workers Builds project "soulslands-site" (W-21): the site is only static assets, no Worker
// script (no "main"). scripts/build-static.sh writes ./dist, including _headers and _redirects, which
// Workers static assets apply. No routes or custom_domain here: Aruto attaches the domain in the
// dashboard. Dashboard settings: README, "Sito statico su Cloudflare".
{
  "name": "soulslands-site",
  "compatibility_date": "2026-11-20",
  // Wrangler runs this before deploy, versions upload and dev, so the dashboard needs no build
  // command; running it twice is harmless (build-static.sh rebuilds dist/ from scratch).
  "build": {
    "command": "bash scripts/build-static.sh",
    // wrangler dev rebuilds when a wiki or devlog page changes; never the whole repo, whose bin/,
    // obj/ and dist/ the build itself rewrites.
    "watch_dir": "src/Soulslands.Web/WikiContent"
  },
  "assets": {
    "directory": "./dist",
    // dist/404.html with status 404 for every path without a file.
    "not_found_handling": "404-page",
    // Pages are dist/<path>/index.html: /Media answers 307 to /Media/.
    "html_handling": "auto-trailing-slash"
  }
}
