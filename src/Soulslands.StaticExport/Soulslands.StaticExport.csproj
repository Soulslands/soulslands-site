<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the public pages of Soulslands.Web into a static folder (scripts/build-static.sh, Cloudflare Pages).
       It hosts the real site in memory (WebApplicationFactory, no socket) and crawls every page it links. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Soulslands.StaticExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soulslands.Web\Soulslands.Web.csproj" />
  </ItemGroup>

</Project>
