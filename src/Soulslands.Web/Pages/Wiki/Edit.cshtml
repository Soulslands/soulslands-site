@page "/wiki/modifica/{slug?}"
@model Soulslands.Web.Pages.Wiki.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nuova pagina" : $"Modifica: {Model.Input.Title}";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="panel mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label asp-for="Input.Title" class="form-label">Titolo</label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.Slug" class="form-label">Indirizzo (slug)</label>
            <input asp-for="Input.Slug" class="form-control" readonly="@(!Model.IsNew)" placeholder="es. razze-e-classi" />
            <span asp-validation-for="Input.Slug" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.Category" class="form-label">Categoria</label>
            <input asp-for="Input.Category" class="form-control" placeholder="es. Regole" />
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.Visibility" class="form-label">Visibilità</label>
            <select asp-for="Input.Visibility" class="form-select">
                <option value="@WikiVisibility.Pubblica">Pubblica: tutti</option>
                <option value="@WikiVisibility.Staff">Staff: solo Admin, Moderatori e Agenti</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Input.Content" class="form-label">Contenuto (Markdown)</label>
            <textarea asp-for="Input.Content" class="form-control font-monospace" rows="18"></textarea>
            <span asp-validation-for="Input.Content" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Salva</button>
        @if (Model.IsNew)
        {
            <a class="btn btn-outline-secondary" asp-page="/Wiki/Index">Annulla</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-page="/Wiki/View" asp-route-slug="@Model.Input.Slug">Annulla</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
