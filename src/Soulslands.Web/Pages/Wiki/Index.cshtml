@page "/wiki"
@model Soulslands.Web.Pages.Wiki.IndexModel
@{
    ViewData["Title"] = "Wiki";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1 class="mb-0">Wiki</h1>
</div>

@* No server behind the site: js/wiki-search.js filters the search index (SearchIndex, written into
   dist/ by the static export). Without JavaScript the box stays hidden and the tree is the index. *@
    <div class="my-4" role="search" id="wiki-search" data-index="@SearchIndex.Url" hidden>
        <input type="search" id="wiki-search-input" class="form-control" placeholder="Cerca nella wiki" aria-label="Cerca nella wiki" autocomplete="off" />
        <p class="text-muted-ss mt-3 mb-0" id="wiki-search-empty" hidden>Nessuna pagina trovata.</p>
        <ul class="list-unstyled mt-3 mb-0 wiki-search-results" id="wiki-search-results"></ul>
    </div>

@if (Model.Pages.Count == 0)
{
    <p class="text-muted-ss">Nessuna pagina trovata.</p>
}

<div class="wiki-index" id="wiki-index">
    <partial name="_WikiTree" model="Model.Sections" />
</div>

@section Scripts {
        <script src="~/js/wiki-search.js" asp-append-version="true"></script>
}
