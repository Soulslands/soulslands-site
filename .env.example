# Copy to .env and fill in. .env is ignored by git.
# Public address of the site, e.g. soulslands.arutosio.com. Its DNS A/AAAA
# records must point to this server: Caddy then gets the HTTPS certificate.
# To try it at home on your network without a domain, use :80 (plain HTTP,
# open http://<the machine's IP> from any device on the network).
# With a domain the site also builds its absolute links (devlog feed) from it
# and answers only requests for that host; with :80 it accepts any host.
SITE_DOMAIN=

POSTGRES_PASSWORD=
# Database backups to keep (one per night).
BACKUP_KEEP=14

# Sign-in goes through the Mahoroba studio (accounts, store, downloads and legal
# pages live there). The secret is the studio's OIDC_SOULSLANDS_SECRET: the same
# value in both .env files (openssl rand -hex 32). Secret.
OIDC_SOULSLANDS_SECRET=
# Only if the studio is not at the default addresses.
STUDIO_ACCOUNT_URL=https://account.mahoroba.studio
STUDIO_URL=https://mahoroba.studio
